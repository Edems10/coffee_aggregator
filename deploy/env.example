# Copy to /etc/coffee-aggregator/env — root-owned, chmod 600. Never commit it.

# The database password. It is only ever used inside the compose network, but
# generate it anyway: openssl rand -hex 24
#
# hex, not base64: this value goes into a postgresql:// URL, and a "/" in it
# ends the URL's authority early — the DSN then resolves the host as "coffee"
# and tries to use the rest of the password as the port number.
POSTGRES_PASSWORD=

# The table browser's basic auth. The proxy is the front door, but this is the
# lock on the data itself: openssl rand -hex 18
PGWEB_USER=coffee
PGWEB_PASSWORD=

# Your timezone, for container logs. Timestamps in the database are always UTC.
TZ=Europe/Prague

# Where the shops can reach you; it goes into the User-Agent of every request.
COFFEE_AGG_CONTACT=https://example.org/contact

# Backups.
COMPOSE_FILE=/opt/coffee-aggregator/deploy/compose.yml
# Put this on a different physical disk than /var/lib/docker if you have one:
# the database and its backup sharing a disk means one failure loses both.
BACKUP_DIR=/var/backups/coffee-aggregator
# The rclone remote and bucket, as configured by `rclone config`. Leave empty
# to keep backups on this machine only.
RCLONE_REMOTE=r2:coffeecrawler
# How many dumps to keep on this machine. Seven gives you a week to notice a
# problem before the only local copies all contain it. A dump is tens of
# megabytes at a realistic catalogue size, so the week costs almost nothing.
# The remote keeps its own history; nothing here ever deletes from it.
KEEP=7

# Crawl shape. site-workers is how many shops run at once; workers is threads
# inside one shop, where 2 is the measured optimum. deadline is in seconds.
SITE_WORKERS=8
WORKERS=2
DEADLINE=17400

# Where the nightly run writes last night's report as a standalone HTML page,
# for reading in a browser instead of the journal, and the directory the little
# web server beside it reads from. Leave REPORT_HTML unset and no page is
# written; the text report still goes to the journal either way.
# REPORT_HTML=/var/www/coffee/index.html
# REPORT_DIR=/var/www/coffee

# Who may open that page. 127.0.0.1 is the host and nothing else; a Tailscale
# address makes it readable from the tailnet without putting it on the LAN.
# REPORT_BIND=127.0.0.1
# REPORT_PORT=8088
