# Copy to .env (git-ignored) and adjust. Real environment variables always win.

# Local docker compose Postgres:
DATABASE_URL=postgresql://coffee:coffee@localhost:5432/coffee
# Host port docker compose publishes Postgres on; set to 5433 when 5432 is taken.
COFFEE_DB_PORT=5432
# AWS RDS:   postgresql://USER:PASSWORD@host.eu-central-1.rds.amazonaws.com:5432/coffee?sslmode=require
# Supabase:  postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres  (direct, not the REST API)

# Who the shops see in their logs, and how they can reach you.
COFFEE_AGG_USER_AGENT=
COFFEE_AGG_CONTACT=https://example.org/contact
# Override the robots.txt product token, when it is not the User-Agent's first token.
COFFEE_AGG_UA_TOKEN=

# Politeness and throughput.
COFFEE_AGG_DELAY=1.0
COFFEE_AGG_WORKERS=4

# Optional conditional-GET cache directory.
COFFEE_AGG_CACHE_DIR=

# Where the EUR/CZK fixing is cached when there is no database (--sink jsonl).
# Default: <COFFEE_AGG_CACHE_DIR>/fx_rates.json, else ~/.cache/coffee-aggregator/fx_rates.json
COFFEE_AGG_FX_CACHE=

# Only for the integration tests (tests/test_postgres_integration.py). They DROP and
# recreate their tables, so point this at a throw-away database, never at the real one:
# TEST_DATABASE_URL=postgresql://coffee:coffee@localhost:5432/coffee_test
